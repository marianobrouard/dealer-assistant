# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
# Check current names at https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Optional tuning (defaults are in src/dealer_assistant/config.py)
# STOCK_PATH=data/stock_sample.csv
# PRIVATE_DIR=data/private
# REQUEST_TIMEOUT_S=20
# MAX_OUTPUT_TOKENS=800
# LLM_MAX_RETRIES=3

# LangSmith tracing sends conversations (customer data!) to LangSmith. Leave it off for real customers.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=dealer-assistant
